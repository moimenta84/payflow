# Base de la API en producción: el mismo dominio del frontend.
# nginx enruta /auth, /wallet, /transactions, /bank, /invoices, /expenses,
# /payments y /admin hacia el api-gateway. Al ser mismo origen, no hay CORS.
# (En desarrollo `npm run dev` no usa este archivo y cae a http://localhost:8080.)
VITE_API_URL=https://payflow.ikermartinezdev.com
